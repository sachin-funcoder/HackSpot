# Server Configuration
NODE_ENV=development
PORT=5000

# Frontend Origin (for CORS with credentials)
CLIENT_URL=http://localhost:5173

# Database Configuration (copy this file to .env and fill in real credentials)
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster-host>/hackspot?retryWrites=true&w=majority

# Authentication Configuration
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_chars
JWT_EXPIRES_IN=7d
AUTH_COOKIE_NAME=hackspot_token

# Optional Demo Seed Admin Configuration (development only; never commit real passwords)
SEED_ADMIN_EMAIL=admin@hackspot.example
SEED_ADMIN_PASSWORD=replace_with_strong_admin_password
SEED_ADMIN_NAME=HackSpot Admin
SEED_ADMIN_COLLEGE=HackSpot Platform Administration
